{
  name: tagctrl

  dut: axi_tagctrl_top

  tb: tb

  tool: xcelium

  fusesoc_core: lowrisc:mocha_dv:tagctrl_sim:0.1

  import_cfgs: [
    "{proj_root}/hw/vendor/lowrisc_ip/dv/tools/dvsim/common_sim_cfg.hjson"
  ]

  // Start with the DUT assertions off for time 0
  overrides: [
    {
      name: run_script
      value: "{proj_root}/hw/ip/tagctrl/dv/tagctrl_sim.tcl"
    }
  ]

  reseed: 1

  uvm_test: tagctrl_base_test
  uvm_test_seq: tagctrl_base_vseq

  tests: [
    {
      name: tagctrl_reset_state
      uvm_test_seq: tagctrl_reset_state_vseq
    }
    {
      name: tagctrl_register_map
      uvm_test_seq: tagctrl_register_map_vseq
      reseed: 3
    }
    {
      name: tagctrl_region_registers_readback
      uvm_test_seq: tagctrl_region_registers_readback_vseq
      reseed: 3
    }
    {
      name: tagctrl_control_start
      uvm_test_seq: tagctrl_control_start_vseq
      reseed: 3
    }
    {
      name: tagctrl_tag_roundtrip
      uvm_test_seq: tagctrl_tag_roundtrip_vseq
      reseed: 5
    }
    {
      name: tagctrl_random
      uvm_test_seq: tagctrl_base_vseq
      reseed: 5
    }
  ]

  regressions: [
    {
      name: smoke
      tests: ["tagctrl_reset_state", "tagctrl_tag_roundtrip"]
    }
    {
      name: v1
      tests: ["tagctrl_reset_state", "tagctrl_register_map", "tagctrl_region_registers_readback",
              "tagctrl_control_start", "tagctrl_tag_roundtrip"]
    }
  ]
}
